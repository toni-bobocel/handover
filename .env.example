# Which fleet description the core loads. Defaults to the demo warehouse.
HANDOVER_FLEET=./deploy/demo/fleet.toml
# The broker's config folder: ./deploy for the demo, ./deploy/site for a real site.
HANDOVER_MQTT=./deploy
# Password of the core's MQTT account, when fleet.toml names password_env.
HANDOVER_MQTT_PASSWORD=
# Where the core finds the built console; the Docker image sets it, dev runs leave it unset.
HANDOVER_UI=ui/dist
